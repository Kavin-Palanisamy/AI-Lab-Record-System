# Environment variables for AI-Lab-Record-System

# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_lab_record_db?schema=public"

# JWT Authentication Secret
JWT_SECRET="replace-with-a-very-long-random-secret-key-32-chars-minimum"
JWT_EXPIRES_IN="24h"

# Server Port
PORT=5000

# File Upload Directory
UPLOAD_DIR="./storage/uploads"

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"

# Node Environment
NODE_ENV="development"
